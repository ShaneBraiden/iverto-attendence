{
  "expo": {
    "name": "Iverto Attendance",
    "slug": "iverto-attendance",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ivertoattendance",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F3F3"
    },
    "assetBundlePatterns": [
      "assets/*.png"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.iverto.attendance"
    },
    "android": {
      "package": "com.iverto.attendance",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3F3F3"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "enableBundleCompression": false,
            "useLegacyPackaging": false,
            "extraProguardRules": "-keepattributes Signature,InnerClasses,EnclosingMethod\n-keepattributes RuntimeVisibleAnnotations,RuntimeVisibleParameterAnnotations\n-keepattributes AnnotationDefault\n-keep class kotlin.Metadata { *; }\n-keep class kotlin.reflect.jvm.internal.** { *; }\n-dontwarn kotlin.**\n-keep class com.facebook.hermes.unicode.** { *; }\n-keep class com.facebook.jni.** { *; }\n-keep class com.swmansion.rnscreens.** { *; }\n-keep class com.swmansion.gesturehandler.** { *; }\n-keep class com.th3rdwave.safeareacontext.** { *; }\n-keep class com.horcrux.svg.** { *; }\n-keepattributes SourceFile,LineNumberTable\n-renamesourcefileattribute SourceFile\n"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "./plugins/with-android-release"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
